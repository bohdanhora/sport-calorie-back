NODE_ENV=development
PORT=4000

POSTGRES_USER=sport_calorie_user
POSTGRES_PASSWORD=admin
POSTGRES_DB=sport_calorie
POSTGRES_PORT=5432

DATABASE_URL="postgresql://sport_calorie_user:admin@localhost:5432/sport_calorie"

JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-string-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

ENCRYPTION_KEY=change-me-to-a-random-64-character-hex-string-for-secret-encryption

# Google sign-in: the OAuth 2.0 Web client ID from Google Cloud Console.
# Leave it empty to keep the Google button off.
GOOGLE_CLIENT_ID=

# 3000 is the dev server, 3100 the one the frontend e2e run starts.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

LOG_LEVEL=debug

SEED_DEMO_USER=true
SEED_DEMO_EMAIL=demo@sport-calorie.local
SEED_DEMO_PASSWORD=demo12345
SEED_DEMO_TIMEZONE=Europe/Kyiv
